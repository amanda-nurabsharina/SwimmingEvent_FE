# ==============================================================================
# FRONTEND DOCKER COMPOSE CONFIGURATION (FE_SE)
# ==============================================================================

# Backend API Endpoint URL (Publicly accessible URL or server domain)
# Example Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Security API Key for public landing endpoints
NEXT_PUBLIC_API_KEY=secret-swimming-api-key-2026

# Landing Web Public URL (Used by CMS for preview and live-scoreboard links)
# Example Production: https://yourdomain.com
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# WhatsApp Gateway Service URL (Optional)
NEXT_PUBLIC_WA_GATEWAY_URL=http://localhost:5001/api/wa

# Host exposed ports
PORT_LANDING=3000
PORT_ADMIN=3001
